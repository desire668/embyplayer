<Window
    x:Class="EmbyPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EmbyPlayer.Models"
    Title="EmbyPlayer">

    <NavigationView x:Name="NavView" PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    ItemInvoked="NavView_ItemInvoked">
        <NavigationView.PaneHeader>
            <StackPanel Spacing="4" Margin="8,8,8,8">
                <TextBlock Text="服务器" FontSize="12" Opacity="0.7" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ComboBox x:Name="ServerBox" MinWidth="150"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ServerBox_SelectionChanged" />
                    <Button Content="＋" Click="AddServer_Click" ToolTipService.ToolTip="添加服务器" />
                </StackPanel>
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="媒体库" Tag="Library" Icon="Video" />
            <NavigationViewItem Content="最近播放" Tag="Resume" Icon="Play" />
            <NavigationViewItem Content="搜索" Tag="Search" Icon="Find" />
            <NavigationViewItem Content="收藏" Tag="Favorites" Icon="Favorite" />
            <NavigationViewItem Content="设置" Tag="Settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
