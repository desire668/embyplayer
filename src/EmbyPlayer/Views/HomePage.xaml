<Page
    x:Class="EmbyPlayer.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyPlayer.Views"
    xmlns:vm="using:EmbyPlayer.ViewModels">

    <Page.Resources>
        <!-- 横向卡片列表：清掉 ListViewItem 自带底色，悬停反馈留给卡片自身 -->
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />

        <!-- 继续播放卡片：16:9 缩略图 + 标题 + 副标题（集号/时间） -->
        <DataTemplate x:Key="ResumeCardTemplate" x:DataType="vm:ItemCard">
            <Grid Width="264" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="148" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="8" Background="#FF2A2A2E">
                    <Grid>
                        <Image Source="{x:Bind Poster, Mode=OneWay}" Stretch="UniformToFill"
                               Visibility="{x:Bind ImageVisibility, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Initial, Mode=OneWay}" FontSize="28" Foreground="#FF777777"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{x:Bind ImagePlaceholderVisibility, Mode=OneWay}" />
                        <!-- 观看进度条贴在缩略图底边 -->
                        <ProgressBar VerticalAlignment="Bottom" MinHeight="3" Height="3"
                                     Minimum="0" Maximum="100" Margin="0"
                                     Value="{x:Bind ResumePercent, Mode=OneWay}"
                                     Visibility="{x:Bind ResumeVisibility, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="2">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind SubtitleOrYear, Mode=OneWay}" FontSize="11" Opacity="0.6"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind SubtitleOrYearVisibility, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- ============ 海报墙首页（TMDB 推荐，未登录也可浏览） ============ -->
        <ScrollViewer Background="Transparent">
            <StackPanel>

                <!-- 有错误时（如未填 TMDB Key、网络失败）在页面顶部提示，空态也看得到 -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="#FFFF6B6B" FontSize="13" TextWrapping="Wrap"
                           MaxWidth="560" HorizontalAlignment="Left" Margin="44,16,44,0" />

                <!-- 大图轮播：没有内容时整块隐藏，否则空的「播放/详情」按钮会浮在欢迎面板上 -->
                <Grid Height="440"
                      Visibility="{x:Bind ViewModel.HeroVisibility, Mode=OneWay}">
                    <!-- 兜底底色：无背景图时也有沉稳的深色衬底 -->
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF14251E" Offset="0" />
                                <GradientStop Color="#FF0B0F12" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Image Source="{x:Bind ViewModel.CurrentHero.Backdrop, Mode=OneWay}"
                           Stretch="UniformToFill" />

                    <!-- 暗色渐变：压住画面下方与左侧，保证文字可读 -->
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#E6000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="0.3" />
                                <GradientStop Color="#33000000" Offset="0.55" />
                                <GradientStop Color="#00000000" Offset="0.8" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#80000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="0.55" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- 左右两侧点击区：点左侧上一张、点右侧下一张。
                         放在信息层之前声明，左下「播放/详情」与右上「连接服务器」叠在它上面，仍然可点。 -->
                    <Grid Width="130" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Background="Transparent" Tapped="HeroPrev_Tapped" />
                    <Grid Width="130" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          Background="Transparent" Tapped="HeroNext_Tapped" />

                    <!-- 顶部页面标题 -->
                    <TextBlock Text="我的首页" FontSize="15" FontWeight="SemiBold"
                               Foreground="#E6FFFFFF" Margin="20,10,0,0" HorizontalAlignment="Left" />

                    <!-- 左下：推荐影片信息 -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="44,0,44,36" Spacing="8" MaxWidth="620">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.CurrentHero.MetaText, Mode=OneWay}"
                                       FontSize="13" Foreground="#CCFFFFFF" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentHero.RatingText, Mode=OneWay}"
                                       FontSize="14" Foreground="#FFFFD24A" FontWeight="SemiBold" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.CurrentHero.Name, Mode=OneWay}"
                                   FontSize="40" FontWeight="Bold" Foreground="White"
                                   TextWrapping="Wrap" MaxLines="2" />

                        <!-- 类型标签胶囊 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentHero.Genres, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Background="#4DFFFFFF" CornerRadius="10" Padding="10,3">
                                        <TextBlock Text="{x:Bind}" FontSize="12" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind ViewModel.CurrentHero.Overview, Mode=OneWay}"
                                   FontSize="13" Foreground="#B3FFFFFF" TextWrapping="Wrap"
                                   MaxLines="2" MaxWidth="560" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Command="{x:Bind ViewModel.PlayHeroCommand, Mode=OneWay}"
                                    Background="White" Foreground="Black"
                                    CornerRadius="6" Padding="22,9" FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="▶" FontSize="13" />
                                    <TextBlock Text="播放" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.OpenHeroDetailCommand, Mode=OneWay}"
                                    Background="#66000000" Foreground="White"
                                    BorderBrush="#55FFFFFF" BorderThickness="1"
                                    CornerRadius="6" Padding="18,9" FontSize="14" Content="详情" />
                        </StackPanel>

                        <!-- 轮播指示条：当前格按轮播进度从左往右填充；点任意一格跳到对应海报 -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Dots, Mode=OneWay}"
                                      Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HeroVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HeroDot">
                                    <!-- 外层加高到 16px 的透明热区：3px 的细条太难点中 -->
                                    <Grid Width="{x:Bind TrackWidth, Mode=OneTime}" Height="16"
                                          Background="Transparent" Tapped="HeroDot_Tapped">
                                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                                Background="{x:Bind TrackBrush, Mode=OneTime}" />
                                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Width="{x:Bind ProgressWidth, Mode=OneWay}"
                                                Background="White" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 加载 / 空态 / 错误 -->
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="暂无推荐内容"
                               Visibility="{x:Bind ViewModel.NoHeroVisibility, Mode=OneWay}"
                               Foreground="#B3FFFFFF" FontSize="14"
                               Margin="44,0,44,36" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
                </Grid>

                <!-- 继续播放 -->
                <StackPanel Margin="44,20,44,24" Spacing="10"
                            Visibility="{x:Bind ViewModel.ResumeSectionVisibility, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="继续播放" FontSize="20" FontWeight="SemiBold" />
                        <HyperlinkButton Content="查看全部 ›" HorizontalAlignment="Right" FontSize="12"
                                         Command="{x:Bind ViewModel.ShowAllResumeCommand, Mode=OneWay}" />
                    </Grid>

                    <ListView x:Name="ResumeList"
                              Background="Transparent"
                              ItemsSource="{x:Bind ViewModel.ResumeItems, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="ResumeList_ItemClick"
                              ItemTemplate="{StaticResource ResumeCardTemplate}"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                </StackPanel>

                <!-- 海报墙：媒体库「最新上架」或「TMDB 热门推荐」 -->
                <StackPanel Margin="44,0,44,32" Spacing="10"
                            Visibility="{x:Bind ViewModel.LatestSectionVisibility, Mode=OneWay}">
                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.WallTitle, Mode=OneWay}"
                                   FontSize="20" FontWeight="SemiBold" />
                        <HyperlinkButton Content="全部 ›" HorizontalAlignment="Right" FontSize="12"
                                         Visibility="{x:Bind ViewModel.ShowAllLatestVisibility, Mode=OneWay}"
                                         Command="{x:Bind ViewModel.ShowAllLatestCommand, Mode=OneWay}" />
                    </Grid>

                    <ListView x:Name="LatestList"
                              Background="Transparent"
                              ItemsSource="{x:Bind ViewModel.LatestItems, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="LatestList_ItemClick"
                              ScrollViewer.HorizontalScrollMode="Enabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemCard">
                                <local:PosterCard Card="{x:Bind}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ============ 未连接服务器且无推荐内容：居中欢迎引导 ============
             必须声明在 ScrollViewer 之后：ScrollViewer 即使背景透明也参与命中测试，
             放在它前面会把下面的两个按钮盖住，表现为「点了没反应」。 -->
        <StackPanel Visibility="{x:Bind ViewModel.WelcomePanelVisibility, Mode=OneWay}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460">
            <TextBlock Text="EmbyPlayer" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="连接你的 Emby 服务器，或填写 TMDB API Key，海报墙即刻呈现" Opacity="0.7"
                       HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" />
            <!-- 固定竖排：窗口一窄，横排两个按钮就会挤在一起叠字 -->
            <StackPanel x:Name="WelcomeButtons" Orientation="Vertical" Spacing="10"
                        HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="＋  连接服务器"
                        FontSize="16" Padding="24,10" MinWidth="240" HorizontalContentAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.GoConnectServerCommand, Mode=OneWay}" />
                <Button Content="填写 TMDB API Key"
                        FontSize="16" Padding="20,10" MinWidth="240" HorizontalContentAlignment="Center"
                        Click="TmdbKey_Click"
                        ToolTipService.ToolTip="没有 Emby 服务器时，用免费的 TMDB Key 也能看在线推荐海报墙" />
            </StackPanel>
            <TextBlock Opacity="0.5" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                       Text="TMDB Key 免费申请，只保存在本机，不会上传到任何地方。也可以稍后在「设置 → 在线内容（TMDB）」里修改。" />
        </StackPanel>
    </Grid>
</Page>
