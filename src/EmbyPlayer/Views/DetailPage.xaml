<Page
    x:Class="EmbyPlayer.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EmbyPlayer.ViewModels">

    <Grid Background="{ThemeResource DetailPageBackground}">
        <Grid.RowDefinitions>
            <!-- 背景只铺上半部分：铺满整页会把小图拉得太模糊 -->
            <RowDefinition Height="0.45*" MinHeight="240" />
            <RowDefinition Height="0.55*" />
        </Grid.RowDefinitions>

        <!-- 影片背景底纹：背景图铺在页面上半部分（下方渐变淡出到页面底色），
             纯装饰，不参与命中测试 -->
        <Grid Grid.Row="0"
              Visibility="{x:Bind ViewModel.BackdropVisibility, Mode=OneWay}"
              IsHitTestVisible="False">
            <Image Source="{x:Bind ViewModel.BackdropSource, Mode=OneWay}"
                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle Fill="{ThemeResource DetailBackdropScrim}" />
            <!-- 顶部再压一层浅渐变，让面包屑与标题更清楚 -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.3" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 底部渐隐到页面底色：铺满整个背景区，过渡拉长，末端与页面底色完全同色 -->
            <Rectangle Fill="{ThemeResource DetailBackdropFade}" />
        </Grid>

        <ScrollViewer x:Name="RootScroll" Grid.RowSpan="2" ViewChanged="RootScroll_ViewChanged">
            <!-- 页面整窗铺满（背景大图铺到标题栏和左边，见 MainWindow.ContentFrame_Navigated），
                 所以内容自己让开：左侧 76（侧栏）+24，顶部 40（标题栏）+52 -->
            <StackPanel Padding="100,92,24,24" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 共享元素动画的落点：与列表里的卡片海报是同一个 key -->
                    <Border x:Name="DetailPoster" Grid.Column="0" Width="220" Height="330"
                            CornerRadius="8" Background="#FF2A2A2E">
                        <!-- 与影片墙卡片共用缓存中的同一张位图，进入详情不再重新加载 -->
                        <Image x:Name="DetailPosterImage" Stretch="UniformToFill"
                               Source="{x:Bind ViewModel.PosterSource, Mode=OneWay}"
                               ImageOpened="DetailPoster_ImageOpened" />
                    </Border>

                    <!-- 最矮与海报齐平（330）；标题换成剧名 logo 后会比文字标题高出一截，
                         内容装不下时整个面板自己长高，简介区再长也最多 220 高、内部滚动 -->
                    <Grid x:Name="InfoPanel" Grid.Column="1" MinHeight="330"
                          VerticalAlignment="Top" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="12">
                            <!-- 标题：优先用 TMDB 的剧名 logo（有字那种剧名字体），
                                 没有 logo 或 logo 加载失败时才退回纯文字片名 -->
                            <Image Source="{x:Bind ViewModel.TitleLogo, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.TitleLogoVisibility, Mode=OneWay}"
                                   MaxWidth="420" MaxHeight="90"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   ImageFailed="TitleLogo_ImageFailed" />
                            <TextBlock Text="{x:Bind ViewModel.Item.Name, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.TitleTextVisibility, Mode=OneWay}"
                                       FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}" FontSize="14" Opacity="0.7" />

                            <!-- 第三方评分：TMDB / IMDb / Trakt，取不到的源不显示 -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Ratings, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.RatingsVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RatingChip">
                                        <Border Background="{ThemeResource RatingChipBackground}"
                                                CornerRadius="8" Padding="10,4" Margin="0,0,8,0"
                                                ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Source}" FontSize="12" Opacity="0.6"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Value}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <!-- TMDB 在线条目没有片源：播放 / 播放源 / 收藏整排不显示 -->
                                <StackPanel Orientation="Horizontal" Spacing="12"
                                            Visibility="{x:Bind ViewModel.PlayVisibility, Mode=OneWay}">
                                    <Button Content="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" MinWidth="160"
                                            Command="{x:Bind ViewModel.PlayCommand}" />
                                    <!-- 播放源：一台以上服务器时才出现，选谁就用谁的片源播 -->
                                    <Button Content="{x:Bind ViewModel.PlaybackSourceText, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.PlaybackSourceVisibility, Mode=OneWay}"
                                            ToolTipService.ToolTip="切换用哪台服务器播放"
                                            Click="PlaySourceButton_Click" />
                                    <Button Content="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.ToggleFavoriteCommand}" />
                                </StackPanel>
                                <ProgressRing IsActive="{x:Bind ViewModel.IsPreparingPlayback, Mode=OneWay}" />
                            </StackPanel>

                            <!-- 只有 TMDB 在线条目才有：说明这是在线信息、库里没有片源 -->
                            <TextBlock Text="{x:Bind ViewModel.TmdbNotice, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.TmdbNoticeVisibility, Mode=OneWay}"
                                       FontSize="13" Opacity="0.75" TextWrapping="Wrap" />

                            <!-- 影片分类：点一下就去媒体库看同类 -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Genres, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.GenresVisibility, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GenreChip">
                                        <Button Content="{x:Bind Name}" Tag="{x:Bind}"
                                                Click="GenreChip_Click"
                                                Margin="0,0,8,0" Padding="12,3"
                                                CornerRadius="12" FontSize="12"
                                                Background="{ThemeResource GenreChipBackground}"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="在媒体库中查看同分类" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 媒体信息：分类下方、简介上方。只显示分辨率 / 码率 / 大小 -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MediaChips, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.MediaInfoVisibility, Mode=OneWay}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MediaChip">
                                        <Border Background="{ThemeResource RatingChipBackground}"
                                                CornerRadius="8" Padding="10,4"
                                                ToolTipService.ToolTip="{x:Bind Value}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Label}" FontSize="12" Opacity="0.6"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Value}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 简介：高度自适应 —— 信息区装得下就全铺开，装不下时最多 220 高、
                             在自己内部滚动；不会把简介压成只剩一两行 -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="220"
                                      Padding="0,0,8,0">
                            <TextBlock Text="{x:Bind ViewModel.Item.Overview, Mode=OneWay}"
                                       TextWrapping="Wrap" LineHeight="20" Opacity="0.85" />
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <StackPanel x:Name="EpisodePanel" Spacing="12"
                            Visibility="{x:Bind ViewModel.EpisodesVisibility, Mode=OneWay}"
                            SizeChanged="EpisodePanel_SizeChanged">
                    <ComboBox Header="季" MinWidth="240" DisplayMemberPath="Name"
                              ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=TwoWay}" />

                    <!-- 每集带截图 + 集号 + 时长 + 简介 -->
                    <ListView ItemsSource="{x:Bind ViewModel.EpisodeRows, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="Episodes_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EpisodeRow">
                                <Grid Padding="4,8" ColumnSpacing="14" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 截图：没有截图时用集号占位 -->
                                    <Border Width="176" Height="99" CornerRadius="6"
                                            Background="#33222222" VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="{x:Bind NumberText}"
                                                       Visibility="{x:Bind PlaceholderVisibility}"
                                                       Opacity="0.45" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{x:Bind Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{x:Bind ThumbnailVisibility}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Top" Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind NumberText}" FontSize="12" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind RuntimeText}" FontSize="12" Opacity="0.6"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="✓ 已看" FontSize="12" Foreground="#FF66BB6A"
                                                       Visibility="{x:Bind WatchedVisibility}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Overview}"
                                                   Visibility="{x:Bind OverviewVisibility}"
                                                   FontSize="12" Opacity="0.72"
                                                   TextWrapping="Wrap" MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" LineHeight="18" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing Grid.RowSpan="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 集列表很长时的快捷跳转：没到底显示「到底部」，到底后变成「回顶部」 -->
        <Button x:Name="JumpButton"
                Grid.RowSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,32,24" Height="40" MinWidth="118" CornerRadius="20"
                ToolTipService.ToolTip="直达底部"
                Visibility="Collapsed"
                Click="JumpButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- ChevronDown / ChevronUp（Segoe Fluent Icons 字形） -->
                <FontIcon x:Name="JumpIcon" Glyph="&#xE70E;" FontSize="14"
                          FontFamily="Segoe Fluent Icons" />
                <TextBlock x:Name="JumpLabel" Text="到底部" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- 轻提示：播放已结束 / 已切换播放源这类一次性消息浮在这里显示，
             几秒后自动淡出，不占页面布局（原来那行常驻状态文字已去掉） -->
        <Border x:Name="Toast" Grid.RowSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56" Padding="18,10" CornerRadius="12"
                Background="{ThemeResource BreadcrumbFill}"
                BorderBrush="{ThemeResource BreadcrumbStroke}" BorderThickness="1"
                IsHitTestVisible="False" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastShift" Y="10" />
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText" FontSize="14" TextWrapping="Wrap" MaxWidth="520" />
        </Border>

        <ContentDialog x:Name="SubtitleDialog" Title="选择字幕"
                       PrimaryButtonText="播放" SecondaryButtonText="取消" DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <ComboBox Header="字幕"
                          ItemsSource="{x:Bind ViewModel.SubtitleOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSubtitle, Mode=TwoWay}"
                          DisplayMemberPath="Label" MinWidth="280" />

                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="弹幕"
                                      IsOn="{x:Bind ViewModel.DanmakuEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="浏览弹幕文件…" Click="BrowseDanmaku_Click" />
                            <TextBlock Text="{x:Bind ViewModel.DanmakuFileName, Mode=OneWay}"
                                       VerticalAlignment="Center" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DanmakuStatus, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
