<Page
    x:Class="EmbyPlayer.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EmbyPlayer.Models">

    <Grid Background="{ThemeResource DetailPageBackground}">
        <Grid.RowDefinitions>
            <!-- 背景只铺上半部分：铺满整页会把小图拉得太模糊 -->
            <RowDefinition Height="0.45*" MinHeight="240" />
            <RowDefinition Height="0.55*" />
        </Grid.RowDefinitions>

        <!-- 影片背景底纹：背景图铺在页面上半部分（下方渐变淡出到页面底色），
             纯装饰，不参与命中测试 -->
        <Grid Grid.Row="0"
              Visibility="{x:Bind ViewModel.BackdropVisibility, Mode=OneWay}"
              IsHitTestVisible="False">
            <Image Source="{x:Bind ViewModel.BackdropSource, Mode=OneWay}"
                   Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Rectangle Fill="{ThemeResource DetailBackdropScrim}" />
            <!-- 顶部再压一层浅渐变，让返回按钮与标题更清楚 -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#33000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.3" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- 底部渐隐到页面底色：铺满整个背景区，过渡拉长，末端与页面底色完全同色 -->
            <Rectangle Fill="{ThemeResource DetailBackdropFade}" />
        </Grid>

        <ScrollViewer x:Name="RootScroll" Grid.RowSpan="2" ViewChanged="RootScroll_ViewChanged">
            <StackPanel Padding="24" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left">

                <Button Click="BackButton_Click" ToolTipService.ToolTip="返回">
                    <SymbolIcon Symbol="Back" />
                </Button>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 共享元素动画的落点：与列表里的卡片海报是同一个 key -->
                    <Border x:Name="DetailPoster" Grid.Column="0" Width="220" Height="330"
                            CornerRadius="8" Background="#FF2A2A2E">
                        <!-- 与影片墙卡片共用缓存中的同一张位图，进入详情不再重新加载 -->
                        <Image x:Name="DetailPosterImage" Stretch="UniformToFill"
                               Source="{x:Bind ViewModel.PosterSource, Mode=OneWay}"
                               ImageOpened="DetailPoster_ImageOpened" />
                    </Border>

                    <StackPanel x:Name="InfoPanel" Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind ViewModel.Item.Name, Mode=OneWay}"
                                   FontSize="32" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.MetaText, Mode=OneWay}" FontSize="14" Opacity="0.7" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{x:Bind ViewModel.PlayButtonText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" MinWidth="160"
                                    Command="{x:Bind ViewModel.PlayCommand}" />
                            <Button Content="{x:Bind ViewModel.FavoriteButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsPreparingPlayback, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="13" Opacity="0.8" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind ViewModel.Item.Overview, Mode=OneWay}"
                                   TextWrapping="Wrap" LineHeight="20" Opacity="0.85" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="EpisodePanel" Spacing="12"
                            Visibility="{x:Bind ViewModel.EpisodesVisibility, Mode=OneWay}"
                            SizeChanged="EpisodePanel_SizeChanged">
                    <ComboBox Header="季" MinWidth="240" DisplayMemberPath="Name"
                              ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSeason, Mode=TwoWay}" />

                    <ListView ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                              SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="Episodes_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BaseItemDto">
                                <Grid Padding="8,10" ColumnSpacing="16" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind IndexNumberText}" Opacity="0.7" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind RuntimeText}" Opacity="0.7" />
                                    <TextBlock Grid.Column="3" Text="✓" FontWeight="Bold"
                                               Foreground="#FF66BB6A"
                                               Visibility="{x:Bind WatchedVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing Grid.RowSpan="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 集列表很长时的快捷跳转：没到底显示「到底部」，到底后变成「回顶部」 -->
        <Button x:Name="JumpButton"
                Grid.RowSpan="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,32,24" Height="40" MinWidth="118" CornerRadius="20"
                ToolTipService.ToolTip="直达底部"
                Visibility="Collapsed"
                Click="JumpButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- ChevronDown / ChevronUp（Segoe Fluent Icons 字形） -->
                <FontIcon x:Name="JumpIcon" Glyph="&#xE70E;" FontSize="14"
                          FontFamily="Segoe Fluent Icons" />
                <TextBlock x:Name="JumpLabel" Text="到底部" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <ContentDialog x:Name="SubtitleDialog" Title="选择字幕"
                       PrimaryButtonText="播放" SecondaryButtonText="取消" DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <ComboBox Header="字幕"
                          ItemsSource="{x:Bind ViewModel.SubtitleOptions, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedSubtitle, Mode=TwoWay}"
                          DisplayMemberPath="Label" MinWidth="280" />

                <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="8">
                        <ToggleSwitch Header="弹幕"
                                      IsOn="{x:Bind ViewModel.DanmakuEnabled, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="浏览弹幕文件…" Click="BrowseDanmaku_Click" />
                            <TextBlock Text="{x:Bind ViewModel.DanmakuFileName, Mode=OneWay}"
                                       VerticalAlignment="Center" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.DanmakuStatus, Mode=OneWay}"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
