<UserControl
    x:Class="EmbyPlayer.Views.SettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <!-- 设置项卡片：左侧标题（可带一行说明），右侧放控件；Stacked=true 时控件换到标题下方整行铺开 -->
    <Border Background="{ThemeResource SettingsCardBackground}"
            CornerRadius="10"
            Padding="16,11"
            Margin="0,0,0,8">
        <Grid x:Name="Layout" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderHost" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                           FontSize="14"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DescBlock"
                           Text="{x:Bind Description, Mode=OneWay}"
                           Opacity="0.55"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <ContentPresenter x:Name="BodyHost"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Content="{x:Bind Body, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
