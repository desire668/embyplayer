<Page
    x:Class="EmbyPlayer.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyPlayer.Views">

    <Grid Padding="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <AutoSuggestBox Grid.Row="0" x:Name="SearchBox" QueryIcon="Find"
                        PlaceholderText="搜索所有服务器的电影 / 剧集 / 单集…"
                        MaxWidth="600" HorizontalAlignment="Left"
                        TextChanged="SearchBox_TextChanged"
                        QuerySubmitted="SearchBox_QuerySubmitted" />

        <local:MediaGridControl Grid.Row="1"
                                Items="{x:Bind ViewModel.Items, Mode=OneWay}"
                                IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                ItemChosen="OnItemChosen" />
    </Grid>
</Page>
