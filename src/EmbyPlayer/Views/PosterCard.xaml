<UserControl
    x:Class="EmbyPlayer.Views.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:EmbyPlayer.Animations">

    <Grid Width="180" Height="330">

        <!-- 阴影宿主：必须先声明，才能落在卡片之下；阴影深度由 FluidShadow 用弹簧驱动 -->
        <Grid x:Name="ShadowHost" Width="180" Height="255" VerticalAlignment="Top" />

        <Grid x:Name="CardRoot"
              anim:FluidCard.IsFluid="True"
              anim:FluidCard.HoverScale="1.045"
              anim:FluidCard.PressScale="0.955"
              anim:FluidCard.Lift="8"
              anim:FluidCard.Parallax="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="255" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Poster" Grid.Row="0" CornerRadius="8" Background="#FF2A2A2E">
                <Grid>
                    <TextBlock Text="{x:Bind Card.Initial, Mode=OneWay}" FontSize="48" Foreground="#FF777777"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Source 指向共享缓存里的同一个 BitmapImage：滚动复用容器、
                         或导航到详情页，都不会再发起第二次请求 -->
                    <Image x:Name="PosterImage" Stretch="UniformToFill"
                           Visibility="{x:Bind Card.ImageVisibility, Mode=OneWay}"
                           Source="{x:Bind Card.Poster, Mode=OneWay}" />

                    <!-- 悬停高光：斜向掠过的一道亮泽，用弹簧渐显，不做硬切换 -->
                    <Border x:Name="HoverVeil" Opacity="0" IsHitTestVisible="False" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.65,1">
                                <GradientStop Color="#26FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.7" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border Visibility="{x:Bind Card.WatchedVisibility, Mode=OneWay}"
                            Background="#CC2E7D32" CornerRadius="4"
                            Padding="6,2" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,8,0">
                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="2,8,2,0" Spacing="4">
                <TextBlock Text="{x:Bind Card.Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind Card.SubtitleOrYear, Mode=OneWay}" FontSize="12" Opacity="0.6"
                           Visibility="{x:Bind Card.SubtitleOrYearVisibility, Mode=OneWay}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Card.ResumePercent, Mode=OneWay}"
                             Visibility="{x:Bind Card.ResumeVisibility, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
