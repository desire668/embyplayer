<UserControl
    x:Class="EmbyPlayer.Views.MediaGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:EmbyPlayer.Animations"
    xmlns:local="using:EmbyPlayer.Views"
    xmlns:vm="using:EmbyPlayer.ViewModels">

    <Grid>
        <!-- Padding 走 GridView 内部：内容离窗口边 16，滚动条照样贴在最右侧 -->
        <GridView x:Name="ItemsGrid"
                  ItemsSource="{x:Bind Items, Mode=OneWay}"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Grid_ItemClick"
                  Padding="0,0,16,0"
                  anim:FluidItems.EntranceEnabled="True">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemCard">
                    <local:PosterCard Card="{x:Bind}" />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="500" />
    </Grid>
</UserControl>
