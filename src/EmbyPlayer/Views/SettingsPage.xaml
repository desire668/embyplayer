<Page
    x:Class="EmbyPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

            <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />

            <StackPanel Spacing="4">
                <TextBlock Text="账户" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.ServerInfo, Mode=OneWay}" Opacity="0.8" />
                <Button Content="退出登录" Command="{x:Bind ViewModel.LogoutCommand}" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="播放" FontSize="16" FontWeight="SemiBold" />
                <ToggleSwitch Header="播完自动播放下一集"
                              IsOn="{x:Bind ViewModel.AutoPlayNext, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="界面" FontSize="16" FontWeight="SemiBold" />
                <ToggleSwitch Header="减弱动效"
                              IsOn="{x:Bind ViewModel.ReduceMotion, Mode=TwoWay}" />
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="开启后取消卡片浮起、海报视差、错峰入场与页面推入动画。系统「设置 → 辅助功能 → 视觉效果」里关闭动画效果时也会自动生效。" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="弹幕" FontSize="16" FontWeight="SemiBold" />
                <ToggleSwitch Header="播放时加载弹幕"
                              IsOn="{x:Bind ViewModel.DanmakuEnabled, Mode=TwoWay}" />
                <TextBox Header="弹幕服务器 URL（LogVar 弹幕 API 基地址，可选）"
                         Text="{x:Bind ViewModel.DanmakuServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="例如 https://dm.wodenas.xin/xiatianembydmff" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                    <NumberBox Header="字号" Value="{x:Bind ViewModel.DanmakuFontSize, Mode=TwoWay}"
                               Minimum="20" Maximum="80" SpinButtonPlacementMode="Compact"
                               Width="120" />
                    <NumberBox Header="不透明度" Value="{x:Bind ViewModel.DanmakuOpacity, Mode=TwoWay}"
                               Minimum="0.1" Maximum="1.0" SpinButtonPlacementMode="Compact"
                               Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <NumberBox Header="滚动时长（秒）" Value="{x:Bind ViewModel.DanmakuScrollDuration, Mode=TwoWay}"
                               Minimum="3" Maximum="20" SpinButtonPlacementMode="Compact"
                               Width="140" />
                    <NumberBox Header="显示区域比例" Value="{x:Bind ViewModel.DanmakuDisplayArea, Mode=TwoWay}"
                               Minimum="0.1" Maximum="1.0" SpinButtonPlacementMode="Compact"
                               Width="140" />
                </StackPanel>
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="说明：弹幕源支持本地 bilibili XML 文件（播放对话框中浏览选择）或配置弹幕服务器自动获取。填写 LogVar 弹幕 API 基地址（如 https://host/token）后，会按影片名自动搜索并匹配对应集数获取弹幕；若 URL 含 {title} 占位符，则按旧版直链模板请求（{title} 替换为影片名）。" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="在线内容（TMDB）" FontSize="16" FontWeight="SemiBold" />
                <TextBox Header="TMDB API Key（v3 auth，可选）"
                         Text="{x:Bind ViewModel.TmdbApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="在 themoviedb.org 免费申请后粘贴到这里" />
                <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                           Text="内容源切到「TMDB 在线推荐」时需要它；未登录服务器时也会用它填充首页。Key 只存在本机设置里，不会随安装包分发。" />
                <HyperlinkButton Content="去 themoviedb.org 申请 API Key"
                                 NavigateUri="https://www.themoviedb.org/settings/api" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="播放器" FontSize="16" FontWeight="SemiBold" />
                <TextBox Header="mpv.exe 路径（留空则自动探测）"
                         Text="{x:Bind ViewModel.MpvPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <Button Content="浏览…" Click="BrowseMpv_Click" />
                    <Button Content="自动探测" Command="{x:Bind ViewModel.DetectMpvCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.MpvStatus, Mode=OneWay}"
                               VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.8" IsTextSelectionEnabled="True">
                    <Run Text="EmbyPlayer " />
                    <Run Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" />
                </TextBlock>
                <HyperlinkButton Content="GitHub 仓库：desire668/embyplayer"
                                 Command="{x:Bind ViewModel.OpenGitHubCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button Content="检查更新"
                            Command="{x:Bind ViewModel.CheckUpdateCommand}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay}"
                                  Width="20" Height="20"
                                  VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
