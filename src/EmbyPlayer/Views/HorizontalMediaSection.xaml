<UserControl
    x:Class="EmbyPlayer.Views.HorizontalMediaSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EmbyPlayer.Views"
    xmlns:vm="using:EmbyPlayer.ViewModels">

    <Grid x:Name="Root">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 分类标题行 ====================
             右留 20：横向列表本身通铺到右边缘，但标题和「查看全部」不贴死窗口边 -->
        <Grid Grid.Row="0" Margin="0,0,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind IsLoading, Mode=OneWay}"
                              VerticalAlignment="Center" />
            </StackPanel>

            <HyperlinkButton Grid.Column="1" Content="查看全部 ›" FontSize="13"
                             VerticalAlignment="Center"
                             Visibility="{x:Bind ViewAllVisibility, Mode=OneWay}"
                             Click="ViewAll_Click" />
        </Grid>

        <!-- 可选的分类描述 -->
        <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}"
                   Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}"
                   FontSize="13" Opacity="0.65" Margin="0,0,20,8" />

        <!-- ==================== 横向卡片列表 ====================
             与首页海报行完全同款：ListView + IsItemClickEnabled + ItemClick，
             卡片动画复用 PosterCard（悬停放大 / 按下缩放 / 视差 / 阴影）。
             之前用 ItemsRepeater + 自绘拖动，点击瞬间鼠标稍有位移就会被判定成
             拖动而吞掉 Tapped，表现为卡片点不进详情页 —— 这里不再自绘拖动，
             横向平移交给 ListView 原生（触摸/触控板都支持）。 -->
        <Grid Grid.Row="2">
            <ListView x:Name="List"
                      Background="Transparent"
                      ItemsSource="{x:Bind Items, Mode=OneWay}"
                      SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="List_ItemClick"
                      PointerWheelChanged="List_PointerWheelChanged"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemCard">
                        <local:PosterCard Card="{x:Bind}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ==================== 左右导航按钮 ====================
                 半透明圆形，覆盖在列表两侧不占布局；默认隐藏，鼠标进入分类区才淡入。 -->
            <Button x:Name="PrevButton"
                    Width="42" Height="42" CornerRadius="21" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                    Background="{ThemeResource CarouselButtonFill}"
                    BorderThickness="1" BorderBrush="{ThemeResource CarouselButtonStroke}"
                    Opacity="0" IsHitTestVisible="False"
                    Click="PrevButton_Click"
                    ToolTipService.ToolTip="向左">
                <FontIcon Glyph="&#xE76B;" FontSize="16" />
            </Button>

            <!-- 右箭头留 12：给贴边的纵向滚动条让出位置，两者不叠在一起 -->
            <Button x:Name="NextButton"
                    Width="42" Height="42" CornerRadius="21" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                    Background="{ThemeResource CarouselButtonFill}"
                    BorderThickness="1" BorderBrush="{ThemeResource CarouselButtonStroke}"
                    Opacity="0" IsHitTestVisible="False"
                    Click="NextButton_Click"
                    ToolTipService.ToolTip="向右">
                <FontIcon Glyph="&#xE76C;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
