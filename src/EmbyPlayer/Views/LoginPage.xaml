<Page
    x:Class="EmbyPlayer.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- 左上角返回：放弃添加服务器时回到海报墙首页 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0"
                Padding="10,5" Background="Transparent" BorderThickness="0"
                Command="{x:Bind ViewModel.GoBackCommand, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="‹" FontSize="15" />
                <TextBlock Text="返回" FontSize="13" />
            </StackPanel>
        </Button>

        <StackPanel Width="360" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="EmbyPlayer" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="连接到你的 Emby 服务器" Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />

            <TextBox Header="服务器地址" PlaceholderText="http://192.168.1.100:8096"
                     Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="用户名"
                     Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox Header="密码"
                         Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="登录" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.LoginCommand, Mode=OneWay}" Margin="0,8,0,0" />

            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
