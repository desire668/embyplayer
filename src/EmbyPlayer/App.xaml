<Application
    x:Class="EmbyPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 影片墙：清掉 GridViewItem 自带的悬停 / 按下灰底，
                 悬停反馈全部交给卡片自己的弹簧动效，避免两层反馈打架 -->
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemFocusBorderBrush" Color="Transparent" />

            <!-- 窗口配色跟随主题：暗主题纯黑，亮主题默认；导航选中态保留品牌蓝 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 详情页背景底纹的压暗蒙版：亮主题用浅底高不透明度，保证文字可读 -->
                    <SolidColorBrush x:Key="DetailBackdropScrim" Color="#FFF3F3F3" Opacity="0.84" />
                    <!-- 详情页页面底色（与渐变终点同色，保证两者衔接无缝） -->
                    <SolidColorBrush x:Key="DetailPageBackground" Color="#FFF3F3F3" />
                    <!-- 背景只铺上半部分，底部一路渐隐到页面底色：终点色必须等于页面底色，否则会露出深色横带 -->
                    <LinearGradientBrush x:Key="DetailBackdropFade" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00F3F3F3" Offset="0" />
                        <GradientStop Color="#00F3F3F3" Offset="0.28" />
                        <GradientStop Color="#7DF3F3F3" Offset="0.70" />
                        <GradientStop Color="#FFF3F3F3" Offset="1" />
                    </LinearGradientBrush>
                    <!-- 首页大图底部渐隐：亮主题下大图上的标题是白字，不能一路淡到浅底，
                         否则字会看不见；这里收在近黑色，仍是一条平滑的长渐变 -->
                    <LinearGradientBrush x:Key="HeroBackdropFade" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.34" />
                        <GradientStop Color="#66000000" Offset="0.72" />
                        <GradientStop Color="#E6000000" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#141D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#1F1D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#291D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF16247F" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF16247F" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF16247F" />
                    <SolidColorBrush x:Key="NavigationViewItemSelectionIndicatorBrush" Color="#FF1D3FD8" />

                    <!-- 设置页（亮色）：页面浅灰、卡片纯白、左栏更浅一档 -->
                    <SolidColorBrush x:Key="SettingsPageBackground" Color="#FFF3F3F3" />
                    <SolidColorBrush x:Key="SettingsNavBackground" Color="#FFEAEAEA" />
                    <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="SettingsCardStroke" Color="#14000000" />
                    <SolidColorBrush x:Key="SettingsNavItemSelected" Color="#FF1F6FEB" />
                    <SolidColorBrush x:Key="SettingsNavItemSelectedForeground" Color="#FFFFFFFF" />
                    <!-- 快捷键胶囊按钮：比卡片底色略深一档，像可按下的键帽 -->
                    <SolidColorBrush x:Key="ShortcutKeyBackground" Color="#FFF0F0F0" />
                    <SolidColorBrush x:Key="ShortcutKeyStroke" Color="#22000000" />
                    <SolidColorBrush x:Key="ShortcutKeyPointerOver" Color="#FFE2E2E2" />

                    <!-- 侧栏圆钮：云母（Mica）系材质，亮主题用浅色半透明玻璃 -->
                    <AcrylicBrush x:Key="RailMicaFill" TintColor="#FFF2F2F2" TintOpacity="0.55"
                                  TintLuminosityOpacity="0.85" FallbackColor="#E6F2F2F2" />
                    <!-- 光泽描边：左上高光 → 右下收暗的斜向渐变，不是完整一圈实线 -->
                    <LinearGradientBrush x:Key="RailGlossStroke" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66FFFFFF" Offset="0" />
                        <GradientStop Color="#14000000" Offset="0.5" />
                        <GradientStop Color="#3D000000" Offset="1" />
                    </LinearGradientBrush>
                    <!-- 顶部高光：让圆钮看起来是块有光泽的玻璃而不是一片平色 -->
                    <LinearGradientBrush x:Key="RailGlossHighlight" StartPoint="0.15,0" EndPoint="0.7,1">
                        <GradientStop Color="#40FFFFFF" Offset="0" />
                        <GradientStop Color="#12FFFFFF" Offset="0.45" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="RailHoverTint" Color="#1A000000" />
                    <!-- 选中态：中性浅灰，不用品牌蓝（暗色下更克制，也不跟页面强调色抢） -->
                    <SolidColorBrush x:Key="RailActiveTint" Color="#2E000000" />

                    <!-- 窗口底色：标题栏透明后，页面上方让出的那条空隙用它填充，避免露出白底 -->
                    <SolidColorBrush x:Key="WindowBackground" Color="#FFF3F3F3" />

                    <!-- 详情页的评分 / 分类胶囊 -->
                    <SolidColorBrush x:Key="RatingChipBackground" Color="#14000000" />
                    <SolidColorBrush x:Key="GenreChipBackground" Color="#1A000000" />
                    <!-- 面包屑浮层：浅色玻璃底，压在背景大图上也能看清 -->
                    <AcrylicBrush x:Key="BreadcrumbFill" TintColor="#F5F5F5" TintOpacity="0.6"
                                  TintLuminosityOpacity="0.9" FallbackColor="#F2F2F2F2" />
                    <SolidColorBrush x:Key="BreadcrumbStroke" Color="#22000000" />
                    <!-- 横向分类列表的左右导航按钮：半透明玻璃圆钮 -->
                    <AcrylicBrush x:Key="CarouselButtonFill" TintColor="#FFFFFF" TintOpacity="0.55"
                                  TintLuminosityOpacity="0.8" FallbackColor="#CCFFFFFF" />
                    <SolidColorBrush x:Key="CarouselButtonStroke" Color="#2E000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- 详情页背景底纹的压暗蒙版：暗主题内容区是纯黑，蒙版也用纯黑 -->
                    <SolidColorBrush x:Key="DetailBackdropScrim" Color="#FF000000" Opacity="0.74" />
                    <!-- 详情页页面底色：实测 WinUI 暗色内容区是 #111111（不是纯黑） -->
                    <SolidColorBrush x:Key="DetailPageBackground" Color="#FF111111" />
                    <!-- 背景只铺上半部分，底部一路渐隐到页面底色：终点色必须等于页面底色，否则会露出深色横带 -->
                    <LinearGradientBrush x:Key="DetailBackdropFade" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00111111" Offset="0" />
                        <GradientStop Color="#00111111" Offset="0.28" />
                        <GradientStop Color="#7D111111" Offset="0.70" />
                        <GradientStop Color="#FF111111" Offset="1" />
                    </LinearGradientBrush>
                    <!-- 首页大图底部渐隐：与详情页背景图同一条曲线，
                         末端与页面底色（#111111）完全同色，大图下边缘不再有一条硬切线 -->
                    <LinearGradientBrush x:Key="HeroBackdropFade" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00111111" Offset="0" />
                        <GradientStop Color="#00111111" Offset="0.34" />
                        <GradientStop Color="#8C111111" Offset="0.72" />
                        <GradientStop Color="#FF111111" Offset="1" />
                    </LinearGradientBrush>
                    <!-- 暗主题：侧边栏与内容区纯黑 -->
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewCollapsedPaneBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF000000" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1F1D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#291D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#331D3FD8" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFE8ECFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFE8ECFF" />
                    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFE8ECFF" />
                    <SolidColorBrush x:Key="NavigationViewItemSelectionIndicatorBrush" Color="#FF7C9BFF" />

                    <!-- 设置页（暗色）：页面近黑、卡片深灰一档，左栏比页面略暗 -->
                    <SolidColorBrush x:Key="SettingsPageBackground" Color="#FF151515" />
                    <SolidColorBrush x:Key="SettingsNavBackground" Color="#FF101010" />
                    <SolidColorBrush x:Key="SettingsCardBackground" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="SettingsCardStroke" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="SettingsNavItemSelected" Color="#FF1F6FEB" />
                    <SolidColorBrush x:Key="SettingsNavItemSelectedForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ShortcutKeyBackground" Color="#FF1B1B1B" />
                    <SolidColorBrush x:Key="ShortcutKeyStroke" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ShortcutKeyPointerOver" Color="#FF262626" />

                    <!-- 侧栏圆钮：云母（Mica）系材质，暗主题用深色半透明玻璃 -->
                    <AcrylicBrush x:Key="RailMicaFill" TintColor="#FF1C1C1C" TintOpacity="0.6"
                                  TintLuminosityOpacity="0.7" FallbackColor="#E61C1C1C" />
                    <LinearGradientBrush x:Key="RailGlossStroke" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8CFFFFFF" Offset="0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.45" />
                        <GradientStop Color="#59FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="RailGlossHighlight" StartPoint="0.15,0" EndPoint="0.7,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="RailHoverTint" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="RailActiveTint" Color="#59FFFFFF" />

                    <SolidColorBrush x:Key="WindowBackground" Color="#FF111111" />

                    <SolidColorBrush x:Key="RatingChipBackground" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="GenreChipBackground" Color="#2EFFFFFF" />
                    <AcrylicBrush x:Key="BreadcrumbFill" TintColor="#1A1A1A" TintOpacity="0.6"
                                  TintLuminosityOpacity="0.7" FallbackColor="#E61A1A1A" />
                    <SolidColorBrush x:Key="BreadcrumbStroke" Color="#33FFFFFF" />
                    <!-- 横向分类列表的左右导航按钮：半透明玻璃圆钮 -->
                    <AcrylicBrush x:Key="CarouselButtonFill" TintColor="#1A1A1A" TintOpacity="0.55"
                                  TintLuminosityOpacity="0.6" FallbackColor="#CC1A1A1A" />
                    <SolidColorBrush x:Key="CarouselButtonStroke" Color="#33FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
